# Dominio base (usalo igual que en tus otros stacks, ej. vaultwarden)
APP_URL=https://firefly.domain.com

# Contraseña de la base de datos de Firefly
FIREFLY_DB_PASSWORD=cambia_esta_contrasena

# APP_KEY: generar con
#   docker run --rm fireflyiii/core:latest artisan key:generate --show
FIREFLY_APP_KEY=base64:SomeRandomStringOf32CharsExactly
